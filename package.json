{
  "name": "evidenceforge",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-gated CI incident resolution on TrueForge",
  "license": "MIT",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.json",
    "format:check": "node scripts/check-format.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:scenarios": "node scripts/run-tests.mjs scenarios",
    "test:failure-injection": "node scripts/run-tests.mjs failure-injection",
    "eval:smoke": "node scripts/run-eval.mjs --smoke",
    "eval": "node scripts/run-eval.mjs",
    "eval:report": "node scripts/run-eval.mjs --write-report",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/apps/server/src/index.js",
    "doctor": "node scripts/doctor.mjs",
    "smoke:trueforge": "node scripts/trueforge-smoke.mjs",
    "demo:fixture": "node --test demo/incident-fixture/test/*.test.mjs",
    "demo:seed": "node demo/incident-fixture/scripts/seed-incident.mjs",
    "demo:reset": "node demo/incident-fixture/scripts/reset-fixture.mjs"
  },
  "dependencies": {
    "@truefoundry/trueforge-sdk": "0.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  }
}
